module NetClear.Tests.NettingAgreementTests where

import Daml.Script
import DA.Date (date, Month(..))
import NetClear.NettingAgreement
import NetClear.Tests.TestUtils

testAddParticipant : Script ()
testAddParticipant = do
  parties <- allocateTestParties
  agreementCid <- createAgreement parties
  newParty <- allocatePartyByHint (PartyIdHint "company-d")
  newCid <- submit parties.operator do
    exerciseCmd agreementCid AddParticipant with newParticipant = newParty
  Some agr <- queryContractId parties.operator newCid
  assert (elem newParty agr.participants)

testCannotAddDuplicateParticipant : Script ()
testCannotAddDuplicateParticipant = do
  parties <- allocateTestParties
  agreementCid <- createAgreement parties
  submitMustFail parties.operator do
    exerciseCmd agreementCid AddParticipant with newParticipant = parties.companyA

testStartNettingCycle : Script ()
testStartNettingCycle = do
  parties <- allocateTestParties
  agreementCid <- createAgreement parties
  cycleCid <- submit parties.operator do
    exerciseCmd agreementCid StartNettingCycle with
      cycleId = "CYCLE-001"
      cutoffTime = testNow
  Some cycle <- queryContractId parties.operator cycleCid
  assert (cycle.status == "OPEN")
  assert (cycle.cycleId == "CYCLE-001")

testStartNettingCycleRequiresTwoParticipants : Script ()
testStartNettingCycleRequiresTwoParticipants = do
  parties <- allocateTestParties
  agreementCid <- submit parties.operator do
    createCmd NettingAgreement with
      operator = parties.operator
      participants = [parties.companyA]
      settlementCurrency = "USD"
      fxOracleParty = parties.operator
      agreementDate = date 2025 Jan 1
      agreementId = "AGREEMENT-ONE-PARTY"
  submitMustFail parties.operator do
    exerciseCmd agreementCid StartNettingCycle with
      cycleId = "CYCLE-ONE-PARTY"
      cutoffTime = testNow
