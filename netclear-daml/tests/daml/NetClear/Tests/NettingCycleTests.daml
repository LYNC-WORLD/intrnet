testCloseCycleRequiresConfirmedInstructions : Script ()
testCloseCycleRequiresConfirmedInstructions = do
  parties <- allocateTestParties
  eurOracleCid <- seedFxOracle parties.operator "EUR" "USD" 1.10
  agreementCid <- createAgreement parties
  payerAcctCid <- seedCashAccount parties.operator parties.companyA "USD" 2000000.0
  receiverAcctCid <- seedCashAccount parties.operator parties.companyB "USD" 2000000.0

  cycleCid <- submit parties.operator do
    exerciseCmd agreementCid StartNettingCycle with
      cycleId = "CYCLE-CLOSE-CONFIRM-001"
      cutoffTime = testNow
  obCid <- createObligation parties.companyA parties.companyB parties.operator 1000.0 "EUR"
  acceptedCid <- acceptObligation parties.companyB obCid
  cycleCid2 <- submit parties.operator do
    exerciseCmd cycleCid AddObligation with obCid = acceptedCid
  cycleCid3 <- submit parties.operator do
    exerciseCmd cycleCid2 ComputeNetPositions with
      fxRateCids = [("EUR", eurOracleCid)]
      ackDeadline = addRelTime testNow (seconds 3600)

  positions <- query @NetPosition parties.operator
  let (posACid, _) =
        expectOne "Expected net position for company A" $
          filter (\(_, pos) -> pos.cycleId == "CYCLE-CLOSE-CONFIRM-001" && pos.participant == parties.companyA) positions
  let (posBCid, _) =
        expectOne "Expected net position for company B" $
          filter (\(_, pos) -> pos.cycleId == "CYCLE-CLOSE-CONFIRM-001" && pos.participant == parties.companyB) positions
  let (posCCid, _) =
        expectOne "Expected net position for company C" $
          filter (\(_, pos) -> pos.cycleId == "CYCLE-CLOSE-CONFIRM-001" && pos.participant == parties.companyC) positions

  _ <- submit parties.companyA do
    exerciseCmd posACid AcknowledgePosition
  _ <- submit parties.companyB do
    exerciseCmd posBCid AcknowledgePosition
  _ <- submit parties.companyC do
    exerciseCmd posCCid AcknowledgePosition

  acknowledgedPositions <- query @NetPosition parties.operator
  let settlementPositionCids =
        map fst $
          filter
            (\(_, pos) -> pos.cycleId == "CYCLE-CLOSE-CONFIRM-001" && pos.status == "ACKNOWLEDGED")
            acknowledgedPositions
  settledCid <- submit parties.operator do
    exerciseCmd cycleCid3 SettleCycle with
      positionCids = settlementPositionCids
  Some settledCycle <- queryContractId parties.operator settledCid
  let instructionCid = expectOne "Expected one settlement instruction" settledCycle.settlementInstructionCids

  submitMustFail parties.operator do
    exerciseCmd settledCid CloseCycle with
      settlementInstructionCids = [instructionCid]

  executedCid <- submit parties.operator do
    exerciseCmd instructionCid ExecuteSettlement with
      payerAcctCid
      receiverAcctCid
  confirmedCid <- submit parties.companyB do
    exerciseCmd executedCid ConfirmReceipt
  Some confirmed <- queryContractId parties.companyB confirmedCid
  assert (confirmed.status == "CONFIRMED")

  closedCid <- submit parties.operator do
    exerciseCmd settledCid CloseCycle with
      settlementInstructionCids = [confirmedCid]
  Some closedCycle <- queryContractId parties.operator closedCid
  assert (closedCycle.status == "CLOSED")
