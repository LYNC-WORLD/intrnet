module NetClear.Tests.NettingCycleTests where

import Daml.Script
import NetClear.NettingAgreement
import NetClear.NettingCycle
import NetClear.NetPosition
import NetClear.Obligation
import NetClear.Tests.TestUtils

testAddAcceptedObligation : Script ()
testAddAcceptedObligation = do
  parties <- allocateTestParties
  agreementCid <- createAgreement parties
  cycleCid <- submit parties.operator do
    exerciseCmd agreementCid StartNettingCycle with
      cycleId = "CYCLE-001"
      cutoffTime = testNow
  obCid <- createObligation parties.companyA parties.companyB parties.operator 1000.0 "USD"
  acceptedCid <- acceptObligation parties.companyB obCid
  newCycleCid <- submit parties.operator do
    exerciseCmd cycleCid AddObligation with obCid = acceptedCid
  Some cycle <- queryContractId parties.operator newCycleCid
  assert (length cycle.obligationCids == 1)

testAddPendingObligationFails : Script ()
testAddPendingObligationFails = do
  parties <- allocateTestParties
  agreementCid <- createAgreement parties
  cycleCid <- submit parties.operator do
    exerciseCmd agreementCid StartNettingCycle with
      cycleId = "CYCLE-002"
      cutoffTime = testNow
  obCid <- createObligation parties.companyA parties.companyB parties.operator 1000.0 "USD"
  submitMustFail parties.operator do
    exerciseCmd cycleCid AddObligation with obCid = obCid

testCannotAddSameObligationTwice : Script ()
testCannotAddSameObligationTwice = do
  parties <- allocateTestParties
  agreementCid <- createAgreement parties
  cycleCid <- submit parties.operator do
    exerciseCmd agreementCid StartNettingCycle with
      cycleId = "CYCLE-DUP-OBL"
      cutoffTime = testNow
  obCid <- createObligation parties.companyA parties.companyB parties.operator 1000.0 "USD"
  acceptedCid <- acceptObligation parties.companyB obCid
  cycleCid2 <- submit parties.operator do
    exerciseCmd cycleCid AddObligation with obCid = acceptedCid
  submitMustFail parties.operator do
    exerciseCmd cycleCid2 AddObligation with obCid = acceptedCid

testObligationAgreementMustMatchCycle : Script ()
testObligationAgreementMustMatchCycle = do
  parties <- allocateTestParties
  agreementCid <- createAgreement parties
  cycleCid <- submit parties.operator do
    exerciseCmd agreementCid StartNettingCycle with
      cycleId = "CYCLE-MISMATCH-AGREEMENT"
      cutoffTime = testNow
  obCid <- submit parties.companyA do
    createCmd Obligation with
      payer = parties.companyA
      receiver = parties.companyB
      amount = 1000.0
      currency = "USD"
      description = "Mismatched agreement obligation"
      invoiceRef = "INV-MISMATCH"
      agreementId = "ANOTHER-AGREEMENT"
      operator = parties.operator
      status = "PENDING"
      createdAt = testNow
  acceptedCid <- acceptObligation parties.companyB obCid
  submitMustFail parties.operator do
    exerciseCmd cycleCid AddObligation with obCid = acceptedCid

testComputeNetPositions : Script ()
testComputeNetPositions = do
  parties <- allocateTestParties
  eurOracleCid <- seedFxOracle parties.operator "EUR" "USD" 1.10
  agreementCid <- createAgreement parties
  cycleCid <- submit parties.operator do
    exerciseCmd agreementCid StartNettingCycle with
      cycleId = "CYCLE-003"
      cutoffTime = testNow
  obCid <- createObligation parties.companyA parties.companyB parties.operator 500000.0 "EUR"
  acceptedCid <- acceptObligation parties.companyB obCid
  cycleCid2 <- submit parties.operator do
    exerciseCmd cycleCid AddObligation with obCid = acceptedCid
  positionCids <- submit parties.operator do
    exerciseCmd cycleCid2 ComputeNetPositions with
      fxRateCids = [("EUR", eurOracleCid)]
  assert (length positionCids == 3)
  positionsA <- query @NetPosition parties.companyA
  assert (length positionsA == 1)
  case positionsA of
    [(_, pos)] -> assert (pos.netAmountSettlement == -550000.0)
    _ -> abort "Expected exactly one net position for company A"

testCloseCycle : Script ()
testCloseCycle = do
  parties <- allocateTestParties
  agreementCid <- createAgreement parties
  cycleCid <- submit parties.operator do
    exerciseCmd agreementCid StartNettingCycle with
      cycleId = "CYCLE-004"
      cutoffTime = testNow
  closedCid <- submit parties.operator do
    exerciseCmd cycleCid CloseCycle
  Some cycle <- queryContractId parties.operator closedCid
  assert (cycle.status == "CLOSED")
