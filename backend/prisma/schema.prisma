datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  oauthProvider       String?
  oauthSub            String?             @unique
  partyId             String?             @unique
  ledgerUserId        String?             @unique
  agreementId         String?
  agreementContractId String?
  role                String
  companyName         String?
  status              String              @default("PENDING")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  onboardingRequest   OnboardingRequest?

  @@index([agreementId])
}

model OnboardingRequest {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName      String
  contactName      String?
  phone            String?
  country          String?
  partyHint        String?
  state            String    @default("DRAFT")
  rejectedBy       String?
  rejectionReason  String?
  rejectedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([state])
}

model OperatorSettings {
  id            String   @id @default("default")
  cronSchedule  String
  fxProvider    String
  notifications Json     @default("{}")
  updatedAt     DateTime @updatedAt
}

model AuditEvent {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  eventType    String
  actorPartyId String?
  contractId   String?
  templateId   String?
  payload      Json
  cycleId      String?

  @@index([timestamp])
  @@index([eventType])
  @@index([actorPartyId])
  @@index([cycleId])
}

model FxRateHistory {
  id           String   @id @default(cuid())
  contractId   String
  fromCurrency String
  toCurrency   String
  rate         Decimal  @db.Decimal(20, 8)
  asOf         DateTime
  recordedAt   DateTime @default(now())

  @@index([fromCurrency, toCurrency])
  @@index([asOf])
}

model PartyBalance {
  id        String   @id @default(cuid())
  partyId   String   @unique
  available Decimal  @default(0) @db.Decimal(20, 8)
  reserved  Decimal  @default(0) @db.Decimal(20, 8)
  currency  String   @default("tUSD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BalanceLedgerEntry {
  id             String   @id @default(cuid())
  partyId        String
  entryType      String
  amount         Decimal  @db.Decimal(20, 8)
  currency       String   @default("tUSD")
  referenceType  String?
  referenceId    String?
  instructionCid String?
  createdBy      String?
  note           String?
  createdAt      DateTime @default(now())

  @@unique([referenceType, referenceId])
  @@unique([instructionCid, entryType])
  @@index([partyId])
  @@index([instructionCid])
  @@index([createdAt])
}
