DATABASE_URL=postgresql://intrnet:secret@postgres:5432/intrnet

PQS_DATABASE_URL=postgresql://pqs:secret@postgres:5432/pqs

PQS_IMAGE=europe-docker.pkg.dev/da-images/public/docker/participant-query-store:3.4.1
PQS_LEDGER_HOST=grpc-ledger-api.localhost
