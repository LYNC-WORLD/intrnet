PQS_POSTGRES_HOST=postgres
PQS_POSTGRES_PORT=5432
PQS_DB_USER=pqs
PQS_DB_PASSWORD=secret
PQS_DB_NAME=pqs
PQS_FILTER_PARTIES="*"
PQS_LEDGER_START=Oldest
PQS_HEALTH_PORT=8080

# -- App --
PORT=3001
NODE_ENV=production
# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -- FX Oracle (ExchangeRate-API) --
FX_API_URL=
