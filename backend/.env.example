
LEDGER_API_URL=http://saga-backend-supra-server:81
LEDGER_API_HOST_HEADER=json-ledger-api.localhost
# Required for ledger writes and PQS reads (package hash after DAR upload)
INTRNET_PACKAGE_ID=
LEDGER_HTTP_TIMEOUT_MS=120000
LEDGER_UPDATES_TIMEOUT_MS=120000
IDENTITY_PROVIDER_ID=

OPERATOR_PARTY=lync-wallet
OPERATOR_EMAIL=operator@intrnet.local
OPERATOR_OAUTH_SUB=

APP_OAUTH_ISSUER=https://your-tenant.eu.auth0.com/
APP_OAUTH_AUDIENCE=https://canton.network.global
APP_OAUTH_JWKS_URL=https://your-tenant.eu.auth0.com/.well-known/jwks.json
APP_OAUTH_CLIENT_ID=your-intrnet-spa-client-id

LEDGER_API_ADMIN_USER=your-m2m-client-id@clients
LEDGER_OAUTH_TOKEN_URL=https://your-tenant.eu.auth0.com/oauth/token
LEDGER_OAUTH_CLIENT_ID=your-m2m-client-id
LEDGER_OAUTH_CLIENT_SECRET=your-m2m-client-secret
LEDGER_OAUTH_AUDIENCE=https://canton.network.global
LEDGER_OAUTH_SCOPE=daml_ledger_api
LEDGER_TOKEN_REFRESH_SKEW_MS=300000

DATABASE_URL=postgresql://intrnet:secret@postgres:5432/intrnet

PQS_DATABASE_URL=postgresql://pqs:secret@postgres:5432/pqs

PQS_IMAGE=europe-docker.pkg.dev/da-images/public/docker/participant-query-store:3.4.1
PQS_LEDGER_HOST=grpc-ledger-api.localhost
PQS_LEDGER_PORT=81
PQS_POSTGRES_HOST=postgres
PQS_POSTGRES_PORT=5432
PQS_DB_USER=pqs
PQS_DB_PASSWORD=secret
PQS_DB_NAME=pqs
PQS_FILTER_PARTIES="*"
PQS_LEDGER_START=Oldest
PQS_HEALTH_PORT=8080

# -- App --
PORT=3001
NODE_ENV=production

# -- FX Oracle (ExchangeRate-API) --
FX_API_URL=
FX_API_KEY=your-exchangerate-api-key
FX_CRON_SCHEDULE="0 */4 * * *"

# -- Currency config --
SETTLEMENT_CURRENCY=USD
SUPPORTED_CURRENCIES=EUR,GBP,JPY,CHF,AUD
APP_DEFAULT_CURRENCY=USD
ONBOARDING_INITIAL_BALANCE=2000000
