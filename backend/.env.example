# -- Canton / DAML --
LEDGER_API_URL=http://localhost:6864
LEDGER_GRPC_HOST=localhost
LEDGER_GRPC_PORT=6865
SANDBOX_HTTP_PORT=6864
# Optional: auto-discovered from ledger if unset
NETCLEAR_PACKAGE_ID=

# JWT tokens for each party
OPERATOR_PARTY=operator
OPERATOR_JWT=eyJ...
OPERATOR_ADMIN_JWT=eyJ...
OPERATOR_EMAIL=operator@netclear.local
OPERATOR_PASSWORD=operator123
OPERATOR_LEDGER_USER_ID=netclear-operator

# -- Database --
DATABASE_URL=postgresql://netclear:secret@localhost:5432/netclear

# -- App --
PORT=3001
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
NODE_ENV=development

# -- Canton onboarding mode --
CANTON_MODE=sandbox
VALIDATOR_API_URL=
VALIDATOR_PARTY_TOKEN_ENDPOINT=
VALIDATOR_STATIC_PARTY_TOKEN=
SANDBOX_JWT_SECRET=change-me-for-sandbox
PARTY_TOKEN_EXPIRES_IN=7d

# -- FX Oracle (ExchangeRate-API) --
# URL is built as FX_API_URL when set, otherwise v6/{FX_API_KEY}/latest/{SETTLEMENT_CURRENCY}
FX_API_URL=
FX_API_KEY=your-exchangerate-api-key
FX_CRON_SCHEDULE=0 */4 * * *

# -- Currency config --
SETTLEMENT_CURRENCY=USD
SUPPORTED_CURRENCIES=EUR,GBP,JPY,CHF,AUD
APP_DEFAULT_CURRENCY=USD
ONBOARDING_INITIAL_BALANCE=2000000
