module Intrnet.SettlementInstruction where

template SettlementInstruction
  with
    payer : Party
    receiver : Party
    amount : Decimal
    currency : Text
    cycleId : Text
    operator : Party
    status : Text
    paymentReference : Optional Text
    failureReason : Optional Text
  where
    signatory operator
    observer [payer, receiver]

    ensure amount > 0.0

    choice AttestPayment : ContractId SettlementInstruction
      with
        paymentUpdateId : Text
      controller operator
      do
        assertMsg "Instruction must be PENDING to attest" (status == "PENDING")
        assertMsg "Payment reference is required" (paymentUpdateId /= "")
        create this with
          status = "EXECUTED"
          paymentReference = Some paymentUpdateId

    choice FailPayment : ContractId SettlementInstruction
      with
        reason : Text
      controller operator
      do
        assertMsg "Instruction must be PENDING to fail" (status == "PENDING")
        create this with
          status = "FAILED"
          failureReason = Some reason

    choice ConfirmReceipt : ContractId SettlementInstruction
      controller receiver
      do
        assertMsg "Instruction must be EXECUTED before confirmation" (status == "EXECUTED")
        create this with status = "CONFIRMED"
