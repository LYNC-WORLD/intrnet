module Intrnet.NettingAgreement where

import Intrnet.NettingCycle

template NettingAgreement
  with
    operator : Party
    participants : [Party]
    settlementCurrency : Text
    fxOracleParty : Party
    agreementDate : Date
    agreementId : Text
  where
    signatory operator
    observer participants

    choice AddParticipant : ContractId NettingAgreement
      with
        newParticipant : Party
      controller operator
      do
        assertMsg "Participant is already in this agreement" (notElem newParticipant participants)
        create this with participants = newParticipant :: participants

    nonconsuming choice StartNettingCycle : ContractId NettingCycle
      with
        cycleId : Text
        cutoffTime : Time
      controller operator
      do
        assertMsg "Netting cycle requires at least two participants" (length participants >= 2)
        create NettingCycle with
          cycleId
          operator
          participants
          settlementCurrency
          obligationCids = []
          status = "OPEN"
          cutoffTime
          agreementId = agreementId
          ackDeadline = None
          positionCids = []
          settlementInstructionCids = []
          settlementPhase = "NOT_SETTLED"
          forceSettled = False
