testFailPayment : Script ()
testFailPayment = do
  parties <- allocateTestParties
  instCid <- submit parties.operator do
    createCmd SettlementInstruction with
      payer = parties.companyA
      receiver = parties.companyB
      amount = 50000.0
      currency = "tUSD"
      cycleId = "CYCLE-001"
      operator = parties.operator
      status = "PENDING"
      paymentReference = None
      failureReason = None
  failedCid <- submit parties.operator do
    exerciseCmd instCid FailPayment with reason = "Insufficient tUSD holdings"
  Some inst <- queryContractId parties.companyB failedCid
  assert (inst.status == "FAILED")
  assert (inst.failureReason == Some "Insufficient tUSD holdings")
