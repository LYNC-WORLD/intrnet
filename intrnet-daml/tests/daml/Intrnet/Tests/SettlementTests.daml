module Intrnet.Tests.SettlementTests where

import Daml.Script
import Intrnet.SettlementInstruction
import Intrnet.Tests.TestUtils

testAttestPayment : Script ()
testAttestPayment = do
  parties <- allocateTestParties
  instCid <- submit parties.operator do
    createCmd SettlementInstruction with
      payer = parties.companyA
      receiver = parties.companyB
      amount = 100000.0
      currency = "tUSD"
      cycleId = "CYCLE-001"
      operator = parties.operator
      status = "PENDING"
      paymentReference = None
      failureReason = None
  executedCid <- submit parties.operator do
    exerciseCmd instCid AttestPayment with paymentUpdateId = "canton-update-001"
  Some inst <- queryContractId parties.companyB executedCid
  assert (inst.status == "EXECUTED")
  assert (inst.paymentReference == Some "canton-update-001")

testAttestPaymentRequiresReference : Script ()
testAttestPaymentRequiresReference = do
  parties <- allocateTestParties
  instCid <- submit parties.operator do
    createCmd SettlementInstruction with
      payer = parties.companyA
      receiver = parties.companyB
      amount = 100000.0
      currency = "tUSD"
      cycleId = "CYCLE-001"
      operator = parties.operator
      status = "PENDING"
      paymentReference = None
      failureReason = None
  submitMustFail parties.operator do
    exerciseCmd instCid AttestPayment with paymentUpdateId = ""

testConfirmReceipt : Script ()
testConfirmReceipt = do
  parties <- allocateTestParties
  instCid <- submit parties.operator do
    createCmd SettlementInstruction with
      payer = parties.companyA
      receiver = parties.companyB
      amount = 50000.0
      currency = "tUSD"
      cycleId = "CYCLE-001"
      operator = parties.operator
      status = "PENDING"
      paymentReference = None
      failureReason = None
  executedCid <- submit parties.operator do
    exerciseCmd instCid AttestPayment with paymentUpdateId = "canton-update-002"
  confirmedCid <- submit parties.companyB do
    exerciseCmd executedCid ConfirmReceipt
  Some inst <- queryContractId parties.companyB confirmedCid
  assert (inst.status == "CONFIRMED")

