module Intrnet.Tests.TestUtils where

import Daml.Script
import Intrnet.FxRateOracle
import Intrnet.NettingAgreement
import Intrnet.NettingCycle
import Intrnet.NetPosition
import Intrnet.CashAccount
import Intrnet.Obligation
import Intrnet.SettlementInstruction
import qualified Intrnet.SettlementLogic as SettlementLogic
import DA.Time (time, addRelTime, seconds)
import DA.Date (date, Month(..))
import DA.Foldable (forA_)
import qualified DA.Foldable as F

data TestParties = TestParties with
    operator : Party
    companyA : Party
    companyB : Party
    companyC : Party

testNow : Time
testNow = time (date 2025 Jan 1) 0 0 0

ackDeadlineOneHour : Time
ackDeadlineOneHour = addRelTime testNow (seconds 3600)

expectOne : Text -> [a] -> a
expectOne msg [] = error msg
expectOne _ (x :: _) = x

allocateTestParties : Script TestParties
allocateTestParties = do
  operator <- allocatePartyByHint (PartyIdHint "operator")
  companyA <- allocatePartyByHint (PartyIdHint "company-a")
  companyB <- allocatePartyByHint (PartyIdHint "company-b")
  companyC <- allocatePartyByHint (PartyIdHint "company-c")
  return TestParties with ..

seedFxOracle : Party -> Text -> Text -> Decimal -> Script (ContractId FxRateOracle)
seedFxOracle operator fromCurrency toCurrency rate =
  submit operator do
    createCmd FxRateOracle with
      operator
      fromCurrency
      toCurrency
      rate
      asOf = testNow

createAgreement : TestParties -> Script (ContractId NettingAgreement)
createAgreement parties =
  submit parties.operator do
    createCmd NettingAgreement with
      operator = parties.operator
      participants = [parties.companyA, parties.companyB, parties.companyC]
      settlementCurrency = "USD"
      fxOracleParty = parties.operator
      agreementDate = date 2025 Jan 1
      agreementId = "AGREEMENT-2025-001"

seedCashAccount : Party -> Party -> Text -> Decimal -> Script (ContractId CashAccount)
seedCashAccount operator owner currency balance =
  submit operator do
    createCmd CashAccount with
      owner
      currency
      balance
      operator

createObligation : Party -> Party -> Party -> Decimal -> Text -> Script (ContractId Obligation)
createObligation payer receiver operator amount currency = do
  submit payer do
    createCmd Obligation with
      payer
      receiver
      amount
      currency
      description = "Test obligation"
      invoiceRef = "INV-001"
      agreementId = "AGREEMENT-2025-001"
      operator
      status = "PENDING"
      createdAt = testNow

acceptObligation : Party -> ContractId Obligation -> Script (ContractId Obligation)
acceptObligation receiver obCid = do
  submit receiver do
    exerciseCmd obCid AcceptObligation

getPositionsForCycle :
  Party -> Text -> Script [(ContractId NetPosition, NetPosition)]
getPositionsForCycle querier cycleId = do
  positions <- query @NetPosition querier
  return $ filter (\(_, pos) -> pos.cycleId == cycleId) positions

getPositionCidsForCycle : Party -> Text -> Script [ContractId NetPosition]
getPositionCidsForCycle querier cycleId =
  map fst <$> getPositionsForCycle querier cycleId

getAcknowledgedPositionCids : Party -> Text -> Script [ContractId NetPosition]
getAcknowledgedPositionCids querier cycleId = do
  positions <- getPositionsForCycle querier cycleId
  return $ map fst $ filter (\(_, pos) -> pos.status == "ACKNOWLEDGED") positions

getPendingPositionCids : Party -> Text -> Script [ContractId NetPosition]
getPendingPositionCids querier cycleId = do
  positions <- getPositionsForCycle querier cycleId
  return $ map fst $ filter (\(_, pos) -> pos.status == "PENDING") positions

acknowledgeAllPositionsForCycle :
  TestParties -> Text -> Script [ContractId NetPosition]
acknowledgeAllPositionsForCycle parties cycleId = do
  pendingCids <- getPendingPositionCids parties.operator cycleId
  assertMsg ("Expected pending positions for cycle " <> cycleId) (not (null pendingCids))
  forA pendingCids $ \positionCid -> do
    Some position <- queryContractId parties.operator positionCid
    submit position.participant do
      exerciseCmd positionCid AcknowledgePosition
  getAcknowledgedPositionCids parties.operator cycleId

setupCycleWithSingleObligation :
  TestParties -> Text -> Decimal -> Text -> Script (ContractId NettingCycle)
setupCycleWithSingleObligation parties cycleId amount currency = do
  fxRateCids <-
    if currency == "USD"
      then return []
      else do
        oracleCid <- seedFxOracle parties.operator currency "USD" 1.10
        return [(currency, oracleCid)]
  agreementCid <- createAgreement parties
  cycleCid <- submit parties.operator do
    exerciseCmd agreementCid StartNettingCycle with
      cycleId
      cutoffTime = testNow
  obCid <- createObligation parties.companyA parties.companyB parties.operator amount currency
  acceptedCid <- acceptObligation parties.companyB obCid
  cycleCid2 <- submit parties.operator do
    exerciseCmd cycleCid AddObligation with obCid = acceptedCid
  submit parties.operator do
    exerciseCmd cycleCid2 ComputeNetPositions with
      fxRateCids
      ackDeadline = ackDeadlineOneHour

data PartyNet = PartyNet with
    party : Party
    net : Decimal

assertNetsSumToZero : [PartyNet] -> Script ()
assertNetsSumToZero nets =
  assert (F.sum (map (.net) nets) == 0.0)

generateSettlementPairs : [PartyNet] -> [(Party, Party, Decimal)]
generateSettlementPairs nets =
  SettlementLogic.generateSettlementPairs $
    map (\n -> (n.party, n.net)) nets

findCashAccountCid : Party -> Party -> Text -> Script (ContractId CashAccount)
findCashAccountCid querier owner currency = do
  accts <- query @CashAccount querier
  let (cid, _) =
        expectOne "Cash account not found for owner" $
          filter (\(_, a) -> a.owner == owner && a.currency == currency) accts
  return cid

executeSettlementsFromNets :
  Party -> Text -> Text -> [(Party, Party, Decimal)] -> Script ()
executeSettlementsFromNets operator cycleId currency settlements =
  forA_ settlements $ \(payer, receiver, amount) -> do
    payerAcctCid <- findCashAccountCid operator payer currency
    receiverAcctCid <- findCashAccountCid operator receiver currency
    instCid <- submit operator do
      createCmd SettlementInstruction with
        payer
        receiver
        amount
        currency
        cycleId
        operator
        status = "PENDING"
    executedCid <- submit operator do
      exerciseCmd instCid ExecuteSettlement with
        payerAcctCid
        receiverAcctCid
    _ <- submit receiver do
      exerciseCmd executedCid ConfirmReceipt
    return ()
