module Intrnet.SetupOperator where

import Daml.Script
import Intrnet.FxRateOracle
import Intrnet.NettingAgreement
import DA.Time (time)
import DA.Date (date, Month(..))
resolveOperator : Optional Party -> Script Party
resolveOperator optParty =
  case optParty of
    Some party -> return party
    None -> allocatePartyByHint (PartyIdHint "operator")

hasFxOracle : [(ContractId FxRateOracle, FxRateOracle)] -> Text -> Bool
hasFxOracle oracles currency =
  any (\(_, oracle) -> oracle.fromCurrency == currency) oracles

createFxOracleIfMissing :
  Party ->
  [(ContractId FxRateOracle, FxRateOracle)] ->
  Text ->
  Decimal ->
  Time ->
  Script ()
createFxOracleIfMissing operator existingOracles fromCurrency rate asOf =
  if hasFxOracle existingOracles fromCurrency then
    return ()
  else do
    _ <- submit operator do
      createCmd FxRateOracle with
        operator
        fromCurrency
        toCurrency = "USD"
        rate
        asOf
    return ()

setupOperator : Optional Party -> Script ()
setupOperator optOperatorParty = do
  operator <- resolveOperator optOperatorParty

  existingAgreements <- query @NettingAgreement operator
  if not (null existingAgreements) then do
    debug "NettingAgreement already exists, skipping bootstrap."
    return ()
  else do
    let now = time (date 2025 Jan 1) 0 0 0
    existingOracles <- query @FxRateOracle operator

    createFxOracleIfMissing operator existingOracles "EUR" 1.10 now
    createFxOracleIfMissing operator existingOracles "GBP" 1.27 now
    createFxOracleIfMissing operator existingOracles "JPY" 0.0067 now

    submit operator do
      createCmd NettingAgreement with
        operator
        participants = []
        settlementCurrency = "USD"
        fxOracleParty = operator
        agreementDate = date 2025 Jan 1
        agreementId = "AGREEMENT-2025-001"

    debug "Operator bootstrap complete (no companies)."
    return ()
